@model PharmacyManagement.Web.ViewModels.ChangePasswordViewModel
@{
    ViewData["Title"] = "Change Password";
}

<h1>Change Password</h1>
<p>Enter your current password, then choose a new password.</p>

<div asp-validation-summary="All" class="message-error"></div>

<form asp-action="ChangePassword" method="post">
    <div class="form-row">
        <label asp-for="CurrentPassword"></label>
        <input asp-for="CurrentPassword" />
        <span asp-validation-for="CurrentPassword" class="field-error"></span>
    </div>
    <div class="form-row">
        <label asp-for="NewPassword"></label>
        <input asp-for="NewPassword" />
        <span asp-validation-for="NewPassword" class="field-error"></span>
    </div>
    <div class="form-row">
        <label asp-for="ConfirmPassword"></label>
        <input asp-for="ConfirmPassword" />
        <span asp-validation-for="ConfirmPassword" class="field-error"></span>
    </div>
    <button type="submit">Change Password</button>
</form>
