@model PharmacyManagement.Web.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Login";
}

<h1>Login</h1>
<p>Sign in to use the Pharmacy Management System.</p>

@if (TempData["Message"] != null)
{
    <p class="message-success">@TempData["Message"]</p>
}

<div asp-validation-summary="All" class="message-error"></div>

<form asp-action="Login" method="post">
    <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
    <div class="form-row">
        <label asp-for="Username"></label>
        <input asp-for="Username" />
        <span asp-validation-for="Username" class="field-error"></span>
    </div>
    <div class="form-row">
        <label asp-for="Password"></label>
        <input asp-for="Password" />
        <span asp-validation-for="Password" class="field-error"></span>
    </div>
    <button type="submit">Login</button>
</form>
