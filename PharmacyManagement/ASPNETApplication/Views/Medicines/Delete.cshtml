@model PharmacyManagement.Web.Models.Medicine
@{
    ViewData["Title"] = "Delete Medicine";
}

<h1>Delete Medicine</h1>
<p>Are you sure you want to delete this medicine?</p>

<p><strong>@Model.Name</strong> (Batch @Model.BatchNumber)</p>
<p>Stock: @Model.StockQuantity | Expiry: @Model.ExpiryDate.ToString("yyyy-MM-dd")</p>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="MedicineId" />
    <button type="submit">Yes, delete</button>
    <a asp-action="Index">Cancel</a>
</form>
