@model IEnumerable<PharmacyManagement.Web.Models.Purchase>
@{
    ViewData["Title"] = "Purchases";
}

<h1>Purchases</h1>
<p>Purchase history and new stock purchases.</p>

<p>
    <a asp-action="Create" class="button-link">New purchase</a>
</p>

<div class="table-wrap">
    <table>
        <thead>
            <tr>
                <th>Date</th>
                <th>Supplier</th>
                <th>Medicine</th>
                <th>Quantity</th>
                <th>Price</th>
                <th>Total</th>
            </tr>
        </thead>
        <tbody>
        @if (!Model.Any())
        {
            <tr>
                <td colspan="6">No purchases recorded yet.</td>
            </tr>
        }
        else
        {
            foreach (var purchase in Model)
            {
                if (purchase.PurchaseItems == null || !purchase.PurchaseItems.Any())
                {
                    <tr>
                        <td>@purchase.PurchaseDate.ToString("yyyy-MM-dd")</td>
                        <td>@(purchase.Supplier != null ? purchase.Supplier.Name : "-")</td>
                        <td colspan="3">-</td>
                        <td>@purchase.TotalAmount.ToString("0.00")</td>
                    </tr>
                }
                else
                {
                    foreach (var item in purchase.PurchaseItems)
                    {
                        <tr>
                            <td>@purchase.PurchaseDate.ToString("yyyy-MM-dd")</td>
                            <td>@(purchase.Supplier != null ? purchase.Supplier.Name : "-")</td>
                            <td>@(item.Medicine != null ? item.Medicine.Name : "-")</td>
                            <td>@item.Quantity</td>
                            <td>@item.Price.ToString("0.00")</td>
                            <td>@item.Total.ToString("0.00")</td>
                        </tr>
                    }
                }
            }
        }
        </tbody>
    </table>
</div>
