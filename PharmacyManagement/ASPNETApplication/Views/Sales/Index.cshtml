@model IEnumerable<PharmacyManagement.Web.Models.Sale>
@{
    ViewData["Title"] = "Sales";
}

<h1>Sales</h1>
<p>Sales history and new sales.</p>

<p>
    <a asp-action="Create" class="button-link">New sale</a>
</p>

<div class="table-wrap">
    <table>
        <thead>
            <tr>
                <th>Date</th>
                <th>Customer</th>
                <th>Medicine</th>
                <th>Quantity</th>
                <th>Price</th>
                <th>Total</th>
            </tr>
        </thead>
        <tbody>
        @if (!Model.Any())
        {
            <tr>
                <td colspan="6">No sales recorded yet.</td>
            </tr>
        }
        else
        {
            foreach (var sale in Model)
            {
                if (sale.SaleItems == null || !sale.SaleItems.Any())
                {
                    <tr>
                        <td>@sale.SaleDate.ToString("yyyy-MM-dd")</td>
                        <td>@(sale.Customer != null ? sale.Customer.Name : "-")</td>
                        <td colspan="3">-</td>
                        <td>@sale.TotalAmount.ToString("0.00")</td>
                    </tr>
                }
                else
                {
                    foreach (var item in sale.SaleItems)
                    {
                        <tr>
                            <td>@sale.SaleDate.ToString("yyyy-MM-dd")</td>
                            <td>@(sale.Customer != null ? sale.Customer.Name : "-")</td>
                            <td>@(item.Medicine != null ? item.Medicine.Name : "-")</td>
                            <td>@item.Quantity</td>
                            <td>@item.Price.ToString("0.00")</td>
                            <td>@item.Total.ToString("0.00")</td>
                        </tr>
                    }
                }
            }
        }
        </tbody>
    </table>
</div>
