@model IEnumerable<PharmacyManagement.Web.Models.Supplier>
@{
    ViewData["Title"] = "Suppliers";
}

<h1>Suppliers</h1>
<p>View, search, add, edit and delete suppliers.</p>

<form method="get" class="search-form">
    <input type="text" name="search" value="@ViewBag.Search" placeholder="Search by name, phone or email" />
    <button type="submit">Search</button>
    <a asp-action="Index">Clear</a>
    <a asp-action="Create" class="button-link">Add Supplier</a>
</form>

<div class="table-wrap">
    <table>
        <thead>
            <tr>
                <th>Name</th>
                <th>Phone</th>
                <th>Email</th>
                <th>Address</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @if (!Model.Any())
        {
            <tr>
                <td colspan="5">No suppliers found.</td>
            </tr>
        }
        else
        {
            foreach (var supplier in Model)
            {
                <tr>
                    <td>@supplier.Name</td>
                    <td>@supplier.Phone</td>
                    <td>@supplier.Email</td>
                    <td>@supplier.Address</td>
                    <td class="actions">
                        <a asp-action="Details" asp-route-id="@supplier.SupplierId">Details</a>
                        <a asp-action="Edit" asp-route-id="@supplier.SupplierId">Edit</a>
                        <a asp-action="Delete" asp-route-id="@supplier.SupplierId">Delete</a>
                    </td>
                </tr>
            }
        }
        </tbody>
    </table>
</div>
